# HTTPS front for expensetrackr on the Lightsail instance (deploy.sh).
#
# SITE_ADDRESS is a domain name or the instance's public IP:
#   - domain: Caddy gets a Let's Encrypt certificate (needs ports 80 and 443
#     open and the domain's DNS pointing at the instance).
#   - IP:     Caddy uses a certificate from its own internal CA, so browsers
#     warn until you switch to a domain.
#
# Everything below in {$...} is set by deploy.sh:
#
#   TLS_MODE         internal (bare IP), acme (domain, Let's Encrypt) or
#                    origin (domain behind Cloudflare with a Cloudflare Origin
#                    CA certificate in /certs, see docs/deploy.md)
#   TRUSTED_PROXIES  who may tell Caddy the real client address: Cloudflare's
#                    IP ranges when the domain is proxied by Cloudflare, else
#                    the loopback address (nobody, in effect)
#   ALLOWED_REMOTES  who may connect at all: Cloudflare's ranges plus
#                    private_ranges (the deploy smoke test) behind
#                    Cloudflare, so nobody bypasses it; 0.0.0.0/0 ::/0 else
#
# default_sni: clients connecting to a bare IP send no SNI, and Caddy then
# picks a certificate by the address the connection arrived on, which inside
# Docker is the container's IP (172.x), not the public one, so the handshake
# fails ("no certificate available for '172.17.0.2'"). default_sni makes those
# clients get the SITE_ADDRESS certificate; it only takes effect with the
# explicit tls block below (Caddy ignores it on its automatic TLS policy).
#
# client_ip_headers: Cloudflare puts the visitor's address in
# CF-Connecting-IP. Caddy reads it only from TRUSTED_PROXIES, so {client_ip}
# is the visitor behind Cloudflare and the TCP peer otherwise; the app gets it
# in X-Real-IP (it trusts that header only from the Docker network, see
# EXPENSE_TRUSTED_PROXIES in deploy.sh).
{
	default_sni {$SITE_ADDRESS}
	servers {
		trusted_proxies static {$TRUSTED_PROXIES}
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(tls_internal) {
	tls {
		issuer internal
	}
}

(tls_acme) {
	tls {
		issuer acme
	}
}

(tls_origin) {
	tls /certs/origin.pem /certs/origin.key
}

{$SITE_ADDRESS} {
	import tls_{$TLS_MODE}

	@direct not remote_ip {$ALLOWED_REMOTES}
	abort @direct

	encode zstd gzip
	reverse_proxy expensetrackr-app:8080 {
		header_up X-Real-IP {client_ip}
	}
}
